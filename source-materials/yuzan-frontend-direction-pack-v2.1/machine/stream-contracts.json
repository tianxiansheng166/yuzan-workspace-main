{
  "version": "2.1.0",
  "reviewMode": "interface-gate-self-review-then-single-batch-review",
  "foundationFreezeRequired": true,
  "streams": [
    {
      "id": "A",
      "name": "Foundation/Home",
      "phase": 1,
      "owns": [
        "semantic-tokens",
        "app-shell-presentation",
        "role-navigation-presentation",
        "home",
        "shared-visual-components",
        "brand-assets"
      ],
      "doesNotOwn": [
        "auth-api",
        "session",
        "refresh",
        "middleware",
        "plugins",
        "business-state"
      ],
      "visuals": [
        "01-home-desktop",
        "01-home-mobile",
        "08-components-buttons",
        "09-motion-storyboard"
      ]
    },
    {
      "id": "AUTH",
      "name": "Auth Visual Adaptation",
      "phase": 2,
      "ownerRule": "existing-acc-web-auth-owner",
      "owns": [
        "login-template",
        "select-school-template"
      ],
      "mustPreserve": [
        "lib-api",
        "auth-ports",
        "auth-adapters",
        "auth-state",
        "middleware",
        "cookie-session-refresh"
      ]
    },
    {
      "id": "B",
      "name": "Teacher",
      "phase": 2,
      "owns": [
        "studio",
        "assignments",
        "teacher-review",
        "teacher-report-presentation"
      ],
      "mustPreserve": [
        "curriculum-gateway",
        "assignment-gateway",
        "submission-gateway",
        "auth",
        "tenant",
        "business-tests"
      ]
    },
    {
      "id": "C",
      "name": "Student",
      "phase": 2,
      "owns": [
        "today",
        "learning-player",
        "student-reports"
      ],
      "deferredUntilOwnerReady": [
        "exercises"
      ],
      "mustPreserve": [
        "learning-state",
        "offline-runtime",
        "submission",
        "auth",
        "visibility"
      ]
    },
    {
      "id": "D",
      "name": "Assessment",
      "phase": 2,
      "owns": [
        "assessment-entry",
        "reading",
        "written",
        "report",
        "history"
      ],
      "mustPreserve": [
        "speech-provider-interface",
        "upload",
        "consent",
        "privacy",
        "analysis-status"
      ]
    },
    {
      "id": "E",
      "name": "Public/Admin/Volunteer",
      "phase": 3,
      "owns": [
        "volunteer",
        "training",
        "translation-entry",
        "products",
        "admin"
      ],
      "doesNotOwn": [
        "home",
        "auth",
        "teacher",
        "student",
        "assessment"
      ]
    }
  ],
  "protectedPaths": "machine/protected-paths.json",
  "git": {
    "singleIntegrationController": true,
    "taskWorktreesPullEachOther": false,
    "ownersPushOwnBranches": true,
    "verificationUsesDetachedWorktree": true,
    "githubSingleSourceOfTruth": true
  },
  "integrationOrder": [
    "design-pack",
    "A",
    "approved-auth",
    "B",
    "C",
    "D",
    "E"
  ],
  "strictIndependentReview": [
    "auth",
    "authorization",
    "multi-tenancy",
    "database-transactions",
    "privacy",
    "file-security",
    "root-security-wiring"
  ]
}
