# ===========================================
# 语赞心声 yuzan-next 环境配置模板
# ===========================================
# 使用方法: 复制此文件到 .env 并填写真实值
# 重要: 绝不要提交 .env 或真实密钥到仓库

# ===========================================
# 应用基础配置
# ===========================================
NODE_ENV=development
COMPOSE_PROJECT_NAME=p0-integration
WEB_ORIGIN=http://127.0.0.1:4175
API_PORT=4000

# ===========================================
# 数据库配置 (PostgreSQL)
# ===========================================
# 格式: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://yuzan:yuzan_dev_only@127.0.0.1:55432/yuzan_dev?schema=public
POSTGRES_USER=yuzan
POSTGRES_PASSWORD=yuzan_dev_only
POSTGRES_DB=yuzan_dev
POSTGRES_PORT=55432
POSTGRES_VOLUME_NAME=yuzan-four-port-postgres-55432

REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=

# ===========================================
# 会话与认证配置
# ===========================================
# 必须生成至少 32 字节的随机值
# Linux/macOS: openssl rand -base64 32
# Windows: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Token 有效期配置
ACCESS_TOKEN_TTL_SECONDS=900        # 15 分钟
REFRESH_TOKEN_TTL_SECONDS=1209600   # 14 天

# ===========================================
# 对象存储配置 (MinIO/S3)
# ===========================================
# 本地开发使用 MinIO，生产环境使用真实 S3
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_BUCKET=yuzan-dev
S3_ACCESS_KEY=minio
# 必须设置自己的密码，不要使用默认值
S3_SECRET_KEY=replace-dev-password
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=replace-dev-password
S3_FORCE_PATH_STYLE=true
MINIO_API_PORT=59000
MINIO_CONSOLE_PORT=59001
# Browser origins allowed to directly upload/download pre-signed recordings.
MINIO_API_CORS_ALLOW_ORIGIN=http://127.0.0.1:4175,http://localhost:4175

# ===========================================
# 语音服务配置
# ===========================================
# disabled 表示暂不启用语音评测功能
SPEECH_PROVIDER=disabled
SPEECH_API_KEY=
SPEECH_API_URL=http://127.0.0.1:8100
SPEECH_API_TIMEOUT_MS=60000
SPEECH_API_MAX_RETRIES=2
FFMPEG_DIR=

# ===========================================
# Worker 与 Flowise 内部连接
# ===========================================
API_INTERNAL_URL=http://127.0.0.1:4000/api/v1/internal
API_INTERNAL_KEY=replace-with-local-internal-key
FLOWISE_BASE_URL=http://127.0.0.1:4300
FLOWISE_FLOW_ID=
FLOWISE_API_KEY=

# ===========================================
# 日志配置
# ===========================================
# development: debug, production: info
LOG_LEVEL=debug

# ===========================================
# 安全提示
# ===========================================
# 1. SESSION_SECRET 必须使用随机生成的值
# 2. S3_SECRET_KEY 必须设置自己的密码
# 3. 生产环境 DATABASE_URL 必须使用安全的密码
# 4. 所有密钥值不应出现在代码或日志中
