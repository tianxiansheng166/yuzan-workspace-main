generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum MembershipRole {
  STUDENT
  TEACHER
  VOLUNTEER
  RESEARCHER
  SCHOOL_ADMIN
  PLATFORM_ADMIN
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  LEFT
}

enum PrivacyRequestType {
  EXPORT
  DELETE
  FREEZE
}

enum PrivacyRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum ProviderCategory {
  SPEECH
  TRANSLATION
  AI
  STORAGE
}

enum ProviderStatus {
  ENABLED
  DISABLED
  DEGRADED
}

enum ProviderHealthStatus {
  HEALTHY
  UNHEALTHY
  MISCONFIGURED
  UNKNOWN
}

enum ProductPlanStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum DataPolicyStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum RetentionJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum AssessmentLinkStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum SchoolImportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum CourseVersionStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  RETIRED
}

enum ActivityType {
  TEXT
  VIDEO
  AUDIO
  CHOICE
  FILL_BLANK
  SPEECH
}

enum ResourceKind {
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  SUBTITLE
  OTHER
}

enum RightsStatus {
  UNKNOWN
  RESTRICTED
  APPROVED
  REJECTED
}

enum AssignmentStatus {
  DRAFT
  SCHEDULED
  OPEN
  CLOSED
  CANCELLED
  ARCHIVED
}

enum SubmissionStatus {
  IN_PROGRESS
  PENDING_SYNC
  SUBMITTED
  PROCESSING
  NEEDS_REVIEW
  REVIEWED
  RETURNED
  ACCEPTED
}

enum FeedbackDecision {
  ACCEPT
  RETURN
}

enum SpeechJobStatus {
  CREATED
  QUALITY_CHECKED
  REJECTED_AUDIO
  PROCESSING
  AUTO_RESULT
  NEEDS_REVIEW
  FINALIZED
  FAILED
}

enum SyncOperationStatus {
  QUEUED
  ACKNOWLEDGED
  CONFLICT
  PERMANENT_FAILURE
}

enum AssignmentTargetType {
  CLASS
  STUDENT
}

enum ContentPackageStatus {
  PENDING
  BUILDING
  READY
  EXPIRED
  FAILED
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum SyncCursorEntityType {
  ASSIGNMENT
  SUBMISSION
  PROGRESS
  CONTENT_PACKAGE
  FEEDBACK
  REPORT
}

enum ReportType {
  STUDENT_GROWTH
  CLASS_SUMMARY
  SCHOOL_OVERVIEW
}

enum ReportStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum SyncBatchStatus {
  ACCEPTED
  DUPLICATE
  CONFLICT
  REJECTED
  PERMISSION_CHANGED
}

enum NotificationType {
  TASK_DEADLINE
  REVIEW_REMINDER
  SYSTEM
  COURSE_REVIEW_RESULT
  ASSESSMENT_ASSIGNED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RecordingStatus {
  INITIALIZED
  UPLOADING
  COMPLETE
  PROCESSING
  READY
  FAILED
}

enum DraftToolSource {
  MINDMATE
  MINDGRAPH
  LESSON_PLAN
  WORKSHEET
}

model School {
  id                      String                   @id @default(uuid()) @db.Uuid
  code                    String                   @unique
  name                    String
  timezone                String                   @default("Asia/Shanghai")
  regionCode              String?
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?
  campuses                Campus[]
  memberships             Membership[]
  terms                   Term[]
  classes                 Class[]
  courses                 Course[]
  assignments             Assignment[]
  devices                 Device[]
  auditLogs               AuditLog[]
  contentPackages         ContentPackage[]
  submissions             Submission[]
  feedback                Feedback[]
  syncJobs                SyncJob[]
  syncCursors             SyncCursor[]
  enrollments             Enrollment[]
  assignmentTargets       AssignmentTarget[]
  activityProgress        ActivityProgress[]
  activityAttempts        ActivityAttempt[]
  reports                 Report[]
  offlinePackages         OfflineContentPackage[]
  syncBatches             SyncBatch[]
  volunteerProfiles       VolunteerProfile[]
  trainingPrograms        TrainingProgram[]
  trainingEnrollments     TrainingEnrollment[]
  trainingExams           TrainingExam[]
  supportPairings         SupportPairing[]
  volunteerServiceTasks   VolunteerServiceTask[]
  volunteerIncidents      VolunteerIncident[]
  notifications           Notification[]
  teacherDrafts           TeacherDraft[]
  inviteCodes             InviteCode[]
  recordings              Recording[]
  learningPlans           LearningPlan[]
  assessmentSessions      AssessmentSession[]
  assessmentReports       AssessmentReport[]
  deviceCheckLogs         DeviceCheckLog[]
  privacyRequests         PrivacyRequest[]
  subscriptions           SchoolSubscription[]
  retentionJobs           PrivacyRetentionJob[]
  assessmentLinks         AssessmentLink[]
  assessmentLinkAccesses  AssessmentLinkAccess[]
  practiceDefinitions     PracticeDefinition[]
  practiceDeliveries      PracticeDelivery[]
  teacherInvitations      TeacherInvitation[]
  studentActivityNotes    StudentActivityNote[]
  courseActivityPractices CourseActivityPractice[]

  @@index([isActive])
  @@index([deletedAt])
}

model Campus {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  name      String
  code      String?
  timezone  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes   Class[]
  devices   Device[]

  @@unique([schoolId, id])
  @@unique([schoolId, name])
  @@index([schoolId, isActive])
}

model User {
  id                       String                @id @default(uuid()) @db.Uuid
  loginIdentifier          String                @unique
  displayName              String
  passwordHash             String
  preferredLocale          String                @default("zh-CN")
  status                   UserStatus            @default(ACTIVE)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  memberships              Membership[]
  sessionPairs             SessionPair[]
  enrollments              Enrollment[]
  authoredCourses          Course[]              @relation("CourseAuthor")
  createdAssignments       Assignment[]
  feedback                 Feedback[]            @relation("FeedbackAuthor")
  auditLogs                AuditLog[]            @relation("AuditActor")
  privacySubjectRequests   PrivacyRequest[]      @relation("PrivacySubject")
  privacyRequestedRequests PrivacyRequest[]      @relation("PrivacyRequester")
  privacyReviewedRequests  PrivacyRequest[]      @relation("PrivacyReviewer")
  privacyRevokedRequests   PrivacyRequest[]      @relation("PrivacyRevoker")
  providerConfigs          ProviderConfig[]
  createdProductPlans      ProductPlan[]
  createdSubscriptions     SchoolSubscription[]
  subscriptionEvents       SubscriptionEvent[]
  dataPolicies             DataPolicyVersion[]
  retentionJobsCreated     PrivacyRetentionJob[]
  schoolImportJobs         SchoolImportJob[]
  createdAssessmentLinks   AssessmentLink[]
  volunteerProfiles        VolunteerProfile[]
  trainingEnrollments      TrainingEnrollment[]

  @@index([status])
}

model SessionPair {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  familyId          String        @db.Uuid
  predecessorPairId String?       @db.Uuid
  activeSchoolId    String?       @db.Uuid
  refreshExpiresAt  DateTime
  revokedAt         DateTime?
  lastUsedAt        DateTime      @default(now())
  createdAt         DateTime      @default(now())
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  predecessor       SessionPair?  @relation("SessionPairRotation", fields: [predecessorPairId], references: [id])
  successors        SessionPair[] @relation("SessionPairRotation")
  sessions          Session[]

  @@unique([familyId, predecessorPairId])
  @@index([userId, refreshExpiresAt])
  @@index([familyId])
}

model Session {
  id        String      @id @default(uuid()) @db.Uuid
  pairId    String      @db.Uuid
  type      String      @db.VarChar(10)
  tokenHash String      @unique
  expiresAt DateTime
  createdAt DateTime    @default(now())
  pair      SessionPair @relation(fields: [pairId], references: [id], onDelete: Cascade)

  @@unique([pairId, type])
}

model Membership {
  id       String           @id @default(uuid()) @db.Uuid
  schoolId String           @db.Uuid
  userId   String           @db.Uuid
  role     MembershipRole
  status   MembershipStatus @default(ACTIVE)
  joinedAt DateTime         @default(now())
  school   School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  devices  Device[]

  @@unique([schoolId, id])
  @@unique([schoolId, userId, role])
  @@index([userId, status])
  @@index([schoolId, role, status])
}

model Term {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  name      String
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes   Class[]

  @@unique([schoolId, id])
  @@unique([schoolId, name])
  @@index([schoolId, isActive])
}

model Class {
  id                 String              @id @default(uuid()) @db.Uuid
  schoolId           String              @db.Uuid
  termId             String              @db.Uuid
  campusId           String?             @db.Uuid
  name               String
  grade              String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  term               Term                @relation(fields: [schoolId, termId], references: [schoolId, id])
  campus             Campus?             @relation(fields: [schoolId, campusId], references: [schoolId, id], onDelete: Restrict)
  enrollments        Enrollment[]
  targets            AssignmentTarget[]
  teacherInvitations TeacherInvitation[]

  @@unique([schoolId, id])
  @@unique([schoolId, termId, name])
  @@index([schoolId, termId])
}

model Enrollment {
  id                 String                @id @default(uuid()) @db.Uuid
  schoolId           String                @db.Uuid
  classId            String                @db.Uuid
  userId             String                @db.Uuid
  role               MembershipRole
  status             MembershipStatus      @default(ACTIVE)
  joinedAt           DateTime              @default(now())
  school             School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class              Class                 @relation(fields: [schoolId, classId], references: [schoolId, id])
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions        Submission[]
  progress           ActivityProgress[]
  targets            AssignmentTarget[]
  recordings         Recording[]
  assessmentSessions AssessmentSession[]
  activityNotes      StudentActivityNote[]

  @@unique([schoolId, id])
  @@unique([classId, userId, role])
  @@index([userId, role, status])
}

/// A teacher-issued, class-scoped invitation. Redeeming it creates the
/// student's school membership and ACTIVE enrollment; it never grants a
/// school-wide role by itself.
model TeacherInvitation {
  id            String    @id @default(uuid()) @db.Uuid
  schoolId      String    @db.Uuid
  classId       String    @db.Uuid
  teacherUserId String    @db.Uuid
  code          String    @unique
  maxUses       Int       @default(30)
  usedCount     Int       @default(0)
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class         Class     @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@index([schoolId, teacherUserId, createdAt])
  @@index([schoolId, classId, expiresAt])
}

model Course {
  id           String          @id @default(uuid()) @db.Uuid
  schoolId     String          @db.Uuid
  authorUserId String          @db.Uuid
  stableKey    String
  title        String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author       User            @relation("CourseAuthor", fields: [authorUserId], references: [id])
  versions     CourseVersion[]

  @@unique([schoolId, id])
  @@unique([schoolId, stableKey])
  @@index([schoolId, authorUserId])
  @@index([deletedAt])
}

model CourseVersion {
  id                 String                  @id @default(uuid()) @db.Uuid
  schoolId           String                  @db.Uuid
  courseId           String                  @db.Uuid
  version            Int
  status             CourseVersionStatus     @default(DRAFT)
  title              String
  description        String?
  gradeBand          String?
  locale             String                  @default("zh-CN")
  dialect            String?
  objectives         Json?
  capabilityTheme    String?
  difficulty         String?
  estimatedMinutes   Int?
  coverAsset         String?
  deviceRequirements Json?
  submittedAt        DateTime?
  approvedAt         DateTime?
  publishedAt        DateTime?
  retiredAt          DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  course             Course                  @relation(fields: [schoolId, courseId], references: [schoolId, id])
  units              Unit[]
  assignments        Assignment[]
  reviews            CourseReview[]
  contentPackages    ContentPackage[]
  offlinePackages    OfflineContentPackage[]

  @@unique([schoolId, id])
  @@unique([courseId, version])
  @@index([status, publishedAt])
}

model CourseReview {
  id              String        @id @default(uuid()) @db.Uuid
  courseVersionId String        @db.Uuid
  reviewerUserId  String        @db.Uuid
  decision        String
  comment         String?
  createdAt       DateTime      @default(now())
  courseVersion   CourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)

  @@index([courseVersionId, createdAt])
}

model Unit {
  id              String        @id @default(uuid()) @db.Uuid
  courseVersionId String        @db.Uuid
  title           String
  sortOrder       Int
  courseVersion   CourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  lessons         Lesson[]

  @@unique([courseVersionId, sortOrder])
}

model Lesson {
  id         String             @id @default(uuid()) @db.Uuid
  unitId     String             @db.Uuid
  title      String
  sortOrder  Int
  unit       Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  activities LearningActivity[]

  @@unique([unitId, sortOrder])
}

model LearningActivity {
  id               String                  @id @default(uuid()) @db.Uuid
  lessonId         String                  @db.Uuid
  type             ActivityType
  title            String
  instruction      Json?
  sortOrder        Int
  required         Boolean                 @default(true)
  completionRule   Json?
  content          Json?
  teacherNotes     Json?
  studentNotes     Json?
  lesson           Lesson                  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  resources        ActivityResource[]
  questions        Question[]
  progress         ActivityProgress[]
  attempts         ActivityAttempt[]
  privateNotes     StudentActivityNote[]
  coursePractice   CourseActivityPractice?
  practiceSessions AssessmentSession[]     @relation("CoursePracticeActivity")

  @@unique([lessonId, sortOrder])
  @@index([lessonId, type])
}

model Resource {
  id             String             @id @default(uuid()) @db.Uuid
  schoolId       String?            @db.Uuid
  kind           ResourceKind
  objectKey      String             @unique
  originalName   String
  mediaType      String
  byteSize       BigInt
  checksumSha256 String
  rightsStatus   RightsStatus       @default(UNKNOWN)
  rightsNote     String?
  offlineAllowed Boolean            @default(false)
  createdAt      DateTime           @default(now())
  deletedAt      DateTime?
  activities     ActivityResource[]
  audioAssets    AudioAsset[]

  @@index([schoolId, kind])
  @@index([checksumSha256])
  @@index([deletedAt])
}

model ActivityResource {
  activityId String           @db.Uuid
  resourceId String           @db.Uuid
  purpose    String
  meta       Json?
  activity   LearningActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  resource   Resource         @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@id([activityId, resourceId, purpose])
}

model Assignment {
  id              String             @id @default(uuid()) @db.Uuid
  schoolId        String             @db.Uuid
  courseVersionId String             @db.Uuid
  createdByUserId String             @db.Uuid
  title           String
  status          AssignmentStatus   @default(DRAFT)
  startsAt        DateTime
  dueAt           DateTime
  offlineRequired Boolean            @default(false)
  completionRule  Json?
  source          String             @default("TEACHER_ASSIGNED")
  revision        Int                @default(1)
  openedAt        DateTime?
  closedAt        DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  school          School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  courseVersion   CourseVersion      @relation(fields: [schoolId, courseVersionId], references: [schoolId, id], onDelete: Restrict)
  createdBy       User               @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  targets         AssignmentTarget[]
  submissions     Submission[]

  @@unique([schoolId, id])
  @@index([schoolId, status])
  @@index([courseVersionId])
  @@index([deletedAt])
}

model AssignmentTarget {
  id           String               @id @default(uuid()) @db.Uuid
  schoolId     String               @db.Uuid
  assignmentId String               @db.Uuid
  targetType   AssignmentTargetType
  classId      String?              @db.Uuid
  enrollmentId String?              @db.Uuid
  createdAt    DateTime             @default(now())
  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignment   Assignment           @relation(fields: [schoolId, assignmentId], references: [schoolId, id], onDelete: Cascade)
  class        Class?               @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Cascade)
  enrollment   Enrollment?          @relation(fields: [schoolId, enrollmentId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@unique([assignmentId, classId])
  @@unique([assignmentId, enrollmentId])
  @@index([schoolId])
  @@index([assignmentId])
}

model ContentPackage {
  id              String               @id @default(uuid()) @db.Uuid
  schoolId        String               @db.Uuid
  courseVersionId String               @db.Uuid
  deviceId        String?              @db.Uuid
  status          ContentPackageStatus @default(PENDING)
  manifest        Json?
  expiresAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  school          School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  courseVersion   CourseVersion        @relation(fields: [schoolId, courseVersionId], references: [schoolId, id], onDelete: Restrict)
  device          Device?              @relation(fields: [schoolId, deviceId], references: [schoolId, id], onDelete: Restrict)

  @@index([schoolId, status])
  @@index([deviceId, status])
  @@index([courseVersionId])
}

model ActivityProgress {
  id           String           @id @default(uuid()) @db.Uuid
  schoolId     String           @db.Uuid
  activityId   String           @db.Uuid
  enrollmentId String           @db.Uuid
  position     Float            @default(0)
  completed    Boolean          @default(false)
  revision     Int              @default(1)
  updatedAt    DateTime         @updatedAt
  school       School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  activity     LearningActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  enrollment   Enrollment       @relation(fields: [schoolId, enrollmentId], references: [schoolId, id], onDelete: Cascade)

  @@unique([activityId, enrollmentId])
  @@index([enrollmentId, updatedAt])
}

model Question {
  id              String           @id @default(uuid()) @db.Uuid
  activityId      String           @db.Uuid
  kind            String
  prompt          Json
  answerKey       Json
  explanation     Json?
  sortOrder       Int
  activity        LearningActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  assessmentItems AssessmentItem[]

  @@unique([activityId, sortOrder])
}

model ActivityAttempt {
  id           String           @id @default(uuid()) @db.Uuid
  schoolId     String           @db.Uuid
  submissionId String           @db.Uuid
  activityId   String           @db.Uuid
  kind         String
  value        Json?
  autoResult   Json?
  createdAt    DateTime         @default(now())
  school       School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  submission   Submission       @relation(fields: [schoolId, submissionId], references: [schoolId, id], onDelete: Cascade)
  activity     LearningActivity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  audioAsset   AudioAsset?
  recording    Recording?

  @@unique([schoolId, id])
  @@unique([submissionId, activityId])
  @@index([schoolId, submissionId])
}

model Submission {
  id               String              @id @default(uuid()) @db.Uuid
  schoolId         String              @db.Uuid
  assignmentId     String              @db.Uuid
  enrollmentId     String              @db.Uuid
  attemptNo        Int
  status           SubmissionStatus    @default(IN_PROGRESS)
  idempotencyKey   String
  deviceId         String?             @db.Uuid
  revision         Int                 @default(1)
  submittedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?
  school           School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignment       Assignment          @relation(fields: [schoolId, assignmentId], references: [schoolId, id], onDelete: Cascade)
  enrollment       Enrollment          @relation(fields: [schoolId, enrollmentId], references: [schoolId, id], onDelete: Restrict)
  device           Device?             @relation(fields: [schoolId, deviceId], references: [schoolId, id], onDelete: Restrict)
  attempts         ActivityAttempt[]
  feedback         Feedback[]
  speechJobs       SpeechJob[]
  recordings       Recording[]
  practiceSessions AssessmentSession[] @relation("CoursePracticeSubmission")

  @@unique([schoolId, id])
  @@unique([assignmentId, enrollmentId, attemptNo])
  @@unique([enrollmentId, idempotencyKey])
  @@index([assignmentId, status])
  @@index([schoolId, status])
  @@index([deletedAt])
}

model Feedback {
  id           String           @id @default(uuid()) @db.Uuid
  schoolId     String           @db.Uuid
  submissionId String           @db.Uuid
  authorUserId String           @db.Uuid
  decision     FeedbackDecision
  comment      String
  score        Float?
  revision     Int              @default(1)
  releasedAt   DateTime         @default(now())
  deletedAt    DateTime?
  school       School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  submission   Submission       @relation(fields: [schoolId, submissionId], references: [schoolId, id], onDelete: Cascade)
  author       User             @relation("FeedbackAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([submissionId, releasedAt])
  @@index([schoolId, releasedAt])
  @@index([deletedAt])
}

model Device {
  id              String           @id @default(uuid()) @db.Uuid
  schoolId        String           @db.Uuid
  campusId        String?          @db.Uuid
  membershipId    String?          @db.Uuid
  label           String?
  platform        String?
  appVersion      String?
  lastSeenAt      DateTime?
  createdAt       DateTime         @default(now())
  deletedAt       DateTime?
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus          Campus?          @relation(fields: [schoolId, campusId], references: [schoolId, id], onDelete: Restrict)
  owner           Membership?      @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Restrict)
  audioAssets     AudioAsset[]
  contentPackages ContentPackage[]
  syncJobs        SyncJob[]
  syncCursors     SyncCursor[]
  submissions     Submission[]

  @@unique([schoolId, id])
  @@index([schoolId, lastSeenAt])
  @@index([deletedAt])
}

model AudioAsset {
  id         String          @id @default(uuid()) @db.Uuid
  attemptId  String          @unique @db.Uuid
  resourceId String          @db.Uuid
  deviceId   String?         @db.Uuid
  durationMs Int
  quality    Json?
  createdAt  DateTime        @default(now())
  attempt    ActivityAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  resource   Resource        @relation(fields: [resourceId], references: [id], onDelete: Restrict)
