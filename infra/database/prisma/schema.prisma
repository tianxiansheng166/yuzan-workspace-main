  @@unique([schoolId, id])
  @@unique([enrollmentId, idempotencyKey])
  @@index([schoolId, status])
  @@index([submissionId])
}

model RecordingChunk {
  id          String    @id @default(uuid()) @db.Uuid
  recordingId String    @db.Uuid
  partNumber  Int
  objectKey   String
  byteSize    Int
  checksumMd5 String?
  createdAt   DateTime  @default(now())
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@unique([recordingId, partNumber])
  @@index([recordingId])
}

// ─── Learning Plan ───────────────────────────────────────

model LearningPlan {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @db.Uuid
  enrollmentId String   @db.Uuid
  authorUserId String   @db.Uuid
  planContent  Json
  periodStart  DateTime
  periodEnd    DateTime
  revision     Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@index([enrollmentId, updatedAt])
  @@index([schoolId, authorUserId])
}

// ─── Assessment ──────────────────────────────────────────

enum AssessmentType {
  READING
  WRITTEN
  MIXED
}

enum AssessmentSessionStatus {
  CREATED
  IN_PROGRESS
  SUBMITTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum AssessmentItemStatus {
  PENDING
  ANSWERED
  REVIEWED
  FLAGGED
}

/// Reusable student practice content is versioned independently of attempts.
/// A PUBLISHED version is append-only: delivery and attempt records always point
/// at the version that was selected when the attempt was created.
enum PracticeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PracticeVisibility {
  SYSTEM
  SCHOOL
}

enum PracticeDeliveryMode {
  ASSIGNMENT
  SELF_PRACTICE
}

enum PracticeDeliveryStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

model PracticeDefinition {
  id               String             @id @default(uuid()) @db.Uuid
  schoolId         String?            @db.Uuid
  visibility       PracticeVisibility @default(SCHOOL)
  title            String
  summary          String
  coverAsset       String?
  difficulty       String
  estimatedMinutes Int
  gradeBand        String             @default("七年级")
  abilityCategories String[]          @default([])
  cultureTags      String[]           @default([])
  catalogType      String             @default("COMPREHENSIVE")
  requiresRecording Boolean           @default(false)
  instantFeedback  Boolean            @default(false)
  status           PracticeStatus     @default(DRAFT)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  school           School?                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  versions         PracticeVersion[]
  courseActivities CourseActivityPractice[]
  favorites        PracticeFavorite[]

  @@index([schoolId, status])
  @@index([visibility, status])
  @@index([gradeBand, difficulty])
}

model PracticeFavorite {
  id           String             @id @default(uuid()) @db.Uuid
  schoolId     String             @db.Uuid
  studentId    String             @db.Uuid
  definitionId String             @db.Uuid
  createdAt    DateTime           @default(now())

  definition PracticeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([schoolId, studentId, definitionId])
  @@index([schoolId, studentId, createdAt])
}

model PracticeVersion {
  id           String         @id @default(uuid()) @db.Uuid
  definitionId String         @db.Uuid
  version      Int
  status       PracticeStatus @default(DRAFT)
  contentHash  String
  publishedAt  DateTime?
  createdAt    DateTime       @default(now())

  definition PracticeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  sections   PracticeSection[]
  deliveries PracticeDelivery[]

  @@unique([definitionId, version])
  @@index([definitionId, status, publishedAt])
}

model PracticeSection {
  id               String  @id @default(uuid()) @db.Uuid
  versionId        String  @db.Uuid
  title            String
  description      String?
  sortOrder        Int
  estimatedMinutes Int

  version PracticeVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  items   PracticeItemRef[]

  @@unique([versionId, sortOrder])
}

model PracticeItemRef {
  id         String  @id @default(uuid()) @db.Uuid
  sectionId  String  @db.Uuid
  questionId String? @db.Uuid
  itemType   String
  sortOrder  Int
  config     Json

  section PracticeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, sortOrder])
  @@index([questionId])
}

model PracticeDelivery {
  id                String                 @id @default(uuid()) @db.Uuid
  practiceVersionId String                 @db.Uuid
  schoolId          String                 @db.Uuid
  classId           String?                @db.Uuid
  studentId         String?                @db.Uuid
  mode              PracticeDeliveryMode
  deadline          DateTime?
  reRecordPolicy    Json
  mobilePolicy      Json
  status            PracticeDeliveryStatus @default(DRAFT)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  practiceVersion PracticeVersion     @relation(fields: [practiceVersionId], references: [id], onDelete: Restrict)
  school          School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  attempts        AssessmentSession[]

  @@index([schoolId, status, mode])
  @@index([schoolId, classId, studentId])
}

model AssessmentSession {
  id                   String                  @id @default(uuid()) @db.Uuid
  schoolId             String                  @db.Uuid
  enrollmentId         String                  @db.Uuid
  classId              String                  @db.Uuid
  initiatorUserId      String                  @db.Uuid
  type                 AssessmentType
  status               AssessmentSessionStatus @default(CREATED)
  startedAt            DateTime?
  submittedAt          DateTime?
  completedAt          DateTime?
  retestOfSessionId    String?                 @db.Uuid
  practiceDefinitionId String?                 @db.Uuid
  practiceVersionId    String?                 @db.Uuid
  deliveryId           String?                 @db.Uuid
  courseActivityId     String?                 @db.Uuid
  courseSubmissionId   String?                 @db.Uuid
  revision             Int                     @default(1)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollment       Enrollment        @relation(fields: [schoolId, enrollmentId], references: [schoolId, id], onDelete: Restrict)
  items            AssessmentItem[]
  report           AssessmentReport?
  delivery         PracticeDelivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  courseActivity   LearningActivity? @relation("CoursePracticeActivity", fields: [courseActivityId], references: [id], onDelete: SetNull)
  courseSubmission Submission?       @relation("CoursePracticeSubmission", fields: [courseSubmissionId], references: [id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@index([schoolId, status])
  @@index([enrollmentId, createdAt])
  @@index([classId])
  @@index([practiceDefinitionId, enrollmentId, status])
  @@index([deliveryId, status])
  @@index([courseActivityId, courseSubmissionId, status])
}

/// A student's private, optimistic-concurrency note for one published activity.
model StudentActivityNote {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @db.Uuid
  enrollmentId String   @db.Uuid
  activityId   String   @db.Uuid
  content      String
  revision     Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollment Enrollment       @relation(fields: [schoolId, enrollmentId], references: [schoolId, id], onDelete: Cascade)
  activity   LearningActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@unique([enrollmentId, activityId])
  @@index([schoolId, enrollmentId, updatedAt])
}

/// Explicit reference from a course activity to the reusable Practice domain.
model CourseActivityPractice {
  id                   String   @id @default(uuid()) @db.Uuid
  schoolId             String   @db.Uuid
  activityId           String   @unique @db.Uuid
  practiceDefinitionId String   @db.Uuid
  required             Boolean  @default(true)
  createdAt            DateTime @default(now())

  school             School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  activity           LearningActivity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  practiceDefinition PracticeDefinition @relation(fields: [practiceDefinitionId], references: [id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@index([schoolId, practiceDefinitionId])
}

model AssessmentItem {
  id              String               @id @default(uuid()) @db.Uuid
  sessionId       String               @db.Uuid
  questionId      String?              @db.Uuid
  recordingId     String?              @db.Uuid
  prompt          Json
  itemType        String
  sectionTitle    String?
  sectionOrder    Int?
  itemConfig      Json?
  status          AssessmentItemStatus @default(PENDING)
  sortOrder       Int
  maxScore        Float?
  scoredScore     Float?
  autoResult      Json?
  reviewerUserId  String?              @db.Uuid
  reviewerComment String?
  reviewedAt      DateTime?
  revision        Int                  @default(1)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  session       AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question      Question?         @relation(fields: [questionId], references: [id], onDelete: SetNull)
  recording     Recording?        @relation(fields: [recordingId], references: [id], onDelete: SetNull)
  writtenAnswer WrittenAnswer?
  speechJobs    SpeechJob[]

  @@unique([sessionId, sortOrder])
  @@index([sessionId, status])
}

model WrittenAnswer {
  id               String    @id @default(uuid()) @db.Uuid
  itemId           String    @unique @db.Uuid
  content          Json
  wordCount        Int       @default(0)
  charCount        Int       @default(0)
  autoSavedAt      DateTime?
  finalSubmittedAt DateTime?
  revision         Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  item AssessmentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model AssessmentReport {
  id                String    @id @default(uuid()) @db.Uuid
  sessionId         String    @unique @db.Uuid
  schoolId          String    @db.Uuid
  overallScore      Float?
  readingScore      Float?
  writtenScore      Float?
  summary           Json?
  recommendations   Json?
  dataCompleteness  Float     @default(0)
  generatedAt       DateTime?
  generatedByUserId String?   @db.Uuid
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  session AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  school  School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@index([schoolId, generatedAt])
}

model DeviceCheckLog {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @db.Uuid
  userId      String   @db.Uuid
  sessionId   String?  @db.Uuid
  checkType   String
  checkResult Json
  userAgent   String?
  createdAt   DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@index([userId, createdAt])
  @@index([sessionId])
}
