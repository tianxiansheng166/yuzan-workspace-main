generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum MembershipRole {
  STUDENT
  TEACHER
  VOLUNTEER
  RESEARCHER
  SCHOOL_ADMIN
  PLATFORM_ADMIN
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  LEFT
}

enum CourseVersionStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  RETIRED
}

enum ActivityType {
  TEXT
  VIDEO
  AUDIO
  CHOICE
  FILL_BLANK
  SPEECH
}

enum ResourceKind {
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  SUBTITLE
  OTHER
}

enum RightsStatus {
  UNKNOWN
  RESTRICTED
  APPROVED
  REJECTED
}

enum AssignmentStatus {
  DRAFT
  SCHEDULED
  OPEN
  CLOSED
  CANCELLED
  ARCHIVED
}

enum SubmissionStatus {
  IN_PROGRESS
  PENDING_SYNC
  SUBMITTED
  PROCESSING
  NEEDS_REVIEW
  REVIEWED
  RETURNED
  ACCEPTED
}

enum FeedbackDecision {
  ACCEPT
  RETURN
}

enum SpeechJobStatus {
  CREATED
  QUALITY_CHECKED
  REJECTED_AUDIO
  PROCESSING
  AUTO_RESULT
  NEEDS_REVIEW
  FINALIZED
  FAILED
}

enum SyncOperationStatus {
  QUEUED
  ACKNOWLEDGED
  CONFLICT
  PERMANENT_FAILURE
}

enum AssignmentTargetType {
  CLASS
  STUDENT
}

enum ContentPackageStatus {
  PENDING
  BUILDING
  READY
  EXPIRED
  FAILED
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum SyncCursorEntityType {
  ASSIGNMENT
  SUBMISSION
  PROGRESS
  CONTENT_PACKAGE
  FEEDBACK
  REPORT
}

enum ReportType {
  STUDENT_GROWTH
  CLASS_SUMMARY
  SCHOOL_OVERVIEW
}

enum ReportStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum SyncBatchStatus {
  ACCEPTED
  DUPLICATE
  CONFLICT
  REJECTED
  PERMISSION_CHANGED
}

model School {
  id                    String                  @id @default(uuid()) @db.Uuid
  code                  String                  @unique
  name                  String
  timezone              String                  @default("Asia/Shanghai")
  regionCode            String?
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  deletedAt             DateTime?
  campuses              Campus[]
  memberships           Membership[]
  terms                 Term[]
  classes               Class[]
  courses               Course[]
  assignments           Assignment[]
  devices               Device[]
  auditLogs             AuditLog[]
  contentPackages       ContentPackage[]
  submissions           Submission[]
  feedback              Feedback[]
  syncJobs              SyncJob[]
  syncCursors           SyncCursor[]
  enrollments           Enrollment[]
  assignmentTargets     AssignmentTarget[]
  activityProgress      ActivityProgress[]
  activityAttempts      ActivityAttempt[]
  reports               Report[]
  offlinePackages       OfflineContentPackage[]
  syncBatches           SyncBatch[]
  volunteerProfiles     VolunteerProfile[]
  trainingPrograms      TrainingProgram[]
  trainingEnrollments   TrainingEnrollment[]
  trainingExams         TrainingExam[]
  supportPairings       SupportPairing[]
  volunteerServiceTasks VolunteerServiceTask[]
  volunteerIncidents    VolunteerIncident[]

  @@index([isActive])
  @@index([deletedAt])
}

model Campus {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  name      String
  code      String?
  timezone  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes   Class[]
  devices   Device[]

  @@unique([schoolId, id])
  @@unique([schoolId, name])
  @@index([schoolId, isActive])
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  loginIdentifier     String               @unique
  displayName         String
  passwordHash        String
  preferredLocale     String               @default("zh-CN")
  status              UserStatus           @default(ACTIVE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  memberships         Membership[]
  sessionPairs        SessionPair[]
  enrollments         Enrollment[]
  authoredCourses     Course[]             @relation("CourseAuthor")
  createdAssignments  Assignment[]
  feedback            Feedback[]           @relation("FeedbackAuthor")
  auditLogs           AuditLog[]           @relation("AuditActor")
  volunteerProfiles   VolunteerProfile[]
  trainingEnrollments TrainingEnrollment[]

  @@index([status])
}

model SessionPair {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  familyId          String        @db.Uuid
  predecessorPairId String?       @db.Uuid
  activeSchoolId    String?       @db.Uuid
  refreshExpiresAt  DateTime
  revokedAt         DateTime?
  lastUsedAt        DateTime      @default(now())
  createdAt         DateTime      @default(now())
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  predecessor       SessionPair?  @relation("SessionPairRotation", fields: [predecessorPairId], references: [id])
  successors        SessionPair[] @relation("SessionPairRotation")
  sessions          Session[]

  @@unique([familyId, predecessorPairId])
  @@index([userId, refreshExpiresAt])
  @@index([familyId])
}

model Session {
  id        String      @id @default(uuid()) @db.Uuid
  pairId    String      @db.Uuid
  type      String      @db.VarChar(10)
  tokenHash String      @unique
  expiresAt DateTime
  createdAt DateTime    @default(now())
  pair      SessionPair @relation(fields: [pairId], references: [id], onDelete: Cascade)

  @@unique([pairId, type])
}

model Membership {
  id       String           @id @default(uuid()) @db.Uuid
  schoolId String           @db.Uuid
  userId   String           @db.Uuid
  role     MembershipRole
  status   MembershipStatus @default(ACTIVE)
  joinedAt DateTime         @default(now())
  school   School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  devices  Device[]

  @@unique([schoolId, id])
  @@unique([schoolId, userId, role])
  @@index([userId, status])
  @@index([schoolId, role, status])
}

model Term {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  name      String
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes   Class[]

  @@unique([schoolId, id])
  @@unique([schoolId, name])
  @@index([schoolId, isActive])
}

model Class {
  id          String             @id @default(uuid()) @db.Uuid
  schoolId    String             @db.Uuid
  termId      String             @db.Uuid
  campusId    String?            @db.Uuid
  name        String
  grade       String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  term        Term               @relation(fields: [schoolId, termId], references: [schoolId, id])
  campus      Campus?            @relation(fields: [schoolId, campusId], references: [schoolId, id], onDelete: Restrict)
  enrollments Enrollment[]
  targets     AssignmentTarget[]

  @@unique([schoolId, id])
  @@unique([schoolId, termId, name])
  @@index([schoolId, termId])
}

model Enrollment {
  id          String             @id @default(uuid()) @db.Uuid
  schoolId    String             @db.Uuid
  classId     String             @db.Uuid
  userId      String             @db.Uuid
  role        MembershipRole
  status      MembershipStatus   @default(ACTIVE)
  joinedAt    DateTime           @default(now())
  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class       Class              @relation(fields: [schoolId, classId], references: [schoolId, id])
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions Submission[]
  progress    ActivityProgress[]
  targets     AssignmentTarget[]

  @@unique([schoolId, id])
  @@unique([classId, userId, role])
  @@index([userId, role, status])
}

model Course {
  id           String          @id @default(uuid()) @db.Uuid
  schoolId     String          @db.Uuid
  authorUserId String          @db.Uuid
  stableKey    String
  title        String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author       User            @relation("CourseAuthor", fields: [authorUserId], references: [id])
  versions     CourseVersion[]

  @@unique([schoolId, id])
  @@unique([schoolId, stableKey])
  @@index([schoolId, authorUserId])
  @@index([deletedAt])
}

model CourseVersion {
  id              String                  @id @default(uuid()) @db.Uuid
  schoolId        String                  @db.Uuid
  courseId        String                  @db.Uuid
  version         Int
  status          CourseVersionStatus     @default(DRAFT)
  title           String
  description     String?
  gradeBand       String?
  locale          String                  @default("zh-CN")
  dialect         String?
  objectives      Json?
  submittedAt     DateTime?
  approvedAt      DateTime?
  publishedAt     DateTime?
  retiredAt       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  course          Course                  @relation(fields: [schoolId, courseId], references: [schoolId, id])
  units           Unit[]
  assignments     Assignment[]
  reviews         CourseReview[]
  contentPackages ContentPackage[]
  offlinePackages OfflineContentPackage[]

  @@unique([schoolId, id])
  @@unique([courseId, version])
  @@index([status, publishedAt])
}

model CourseReview {
  id              String        @id @default(uuid()) @db.Uuid
  courseVersionId String        @db.Uuid
  reviewerUserId  String        @db.Uuid
  decision        String
  comment         String?
  createdAt       DateTime      @default(now())
  courseVersion   CourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)

  @@index([courseVersionId, createdAt])
}

model Unit {
  id              String        @id @default(uuid()) @db.Uuid
  courseVersionId String        @db.Uuid
  title           String
  sortOrder       Int
  courseVersion   CourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  lessons         Lesson[]

  @@unique([courseVersionId, sortOrder])
}

model Lesson {
  id         String             @id @default(uuid()) @db.Uuid
  unitId     String             @db.Uuid
  title      String
  sortOrder  Int
  unit       Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  activities LearningActivity[]

  @@unique([unitId, sortOrder])
}

model LearningActivity {
  id             String             @id @default(uuid()) @db.Uuid
  lessonId       String             @db.Uuid
  type           ActivityType
  title          String
  instruction    Json?
  sortOrder      Int
  required       Boolean            @default(true)
  completionRule Json?
  content        Json?
  teacherNotes   Json?
  studentNotes   Json?
  lesson         Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  resources      ActivityResource[]
  questions      Question[]
  progress       ActivityProgress[]
  attempts       ActivityAttempt[]

  @@unique([lessonId, sortOrder])
  @@index([lessonId, type])
}

model Resource {
  id             String             @id @default(uuid()) @db.Uuid
  schoolId       String?            @db.Uuid
  kind           ResourceKind
  objectKey      String             @unique
  originalName   String
  mediaType      String
  byteSize       BigInt
  checksumSha256 String
  rightsStatus   RightsStatus       @default(UNKNOWN)
  rightsNote     String?
  offlineAllowed Boolean            @default(false)
  createdAt      DateTime           @default(now())
  deletedAt      DateTime?
  activities     ActivityResource[]
  audioAssets    AudioAsset[]

  @@index([schoolId, kind])
  @@index([checksumSha256])
  @@index([deletedAt])
}

model ActivityResource {
  activityId String           @db.Uuid
  resourceId String           @db.Uuid
  purpose    String
  meta       Json?
  activity   LearningActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  resource   Resource         @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@id([activityId, resourceId, purpose])
}

model Assignment {
  id              String             @id @default(uuid()) @db.Uuid
  schoolId        String             @db.Uuid
  courseVersionId String             @db.Uuid
  createdByUserId String             @db.Uuid
  title           String
  status          AssignmentStatus   @default(DRAFT)
  startsAt        DateTime
  dueAt           DateTime
  offlineRequired Boolean            @default(false)
  completionRule  Json?
  revision        Int                @default(1)
  openedAt        DateTime?
  closedAt        DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  school          School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  courseVersion   CourseVersion      @relation(fields: [schoolId, courseVersionId], references: [schoolId, id], onDelete: Restrict)
  createdBy       User               @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  targets         AssignmentTarget[]
  submissions     Submission[]

  @@unique([schoolId, id])
  @@index([schoolId, status])
  @@index([courseVersionId])
  @@index([deletedAt])
}

model AssignmentTarget {
  id           String               @id @default(uuid()) @db.Uuid
  schoolId     String               @db.Uuid
  assignmentId String               @db.Uuid
  targetType   AssignmentTargetType
  classId      String?              @db.Uuid
  enrollmentId String?              @db.Uuid
  createdAt    DateTime             @default(now())
  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignment   Assignment           @relation(fields: [schoolId, assignmentId], references: [schoolId, id], onDelete: Cascade)
  class        Class?               @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Cascade)
  enrollment   Enrollment?          @relation(fields: [schoolId, enrollmentId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@unique([assignmentId, classId])
  @@unique([assignmentId, enrollmentId])
  @@index([schoolId])
  @@index([assignmentId])
}

model ContentPackage {
  id              String               @id @default(uuid()) @db.Uuid
  schoolId        String               @db.Uuid
  courseVersionId String               @db.Uuid
  deviceId        String?              @db.Uuid
  status          ContentPackageStatus @default(PENDING)
  manifest        Json?
  expiresAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  school          School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  courseVersion   CourseVersion        @relation(fields: [schoolId, courseVersionId], references: [schoolId, id], onDelete: Restrict)
  device          Device?              @relation(fields: [schoolId, deviceId], references: [schoolId, id], onDelete: Restrict)

  @@index([schoolId, status])
  @@index([deviceId, status])
  @@index([courseVersionId])
}

model ActivityProgress {
  id           String           @id @default(uuid()) @db.Uuid
  schoolId     String           @db.Uuid
  activityId   String           @db.Uuid
  enrollmentId String           @db.Uuid
  position     Float            @default(0)
  completed    Boolean          @default(false)
  revision     Int              @default(1)
  updatedAt    DateTime         @updatedAt
  school       School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  activity     LearningActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  enrollment   Enrollment       @relation(fields: [schoolId, enrollmentId], references: [schoolId, id], onDelete: Cascade)

  @@unique([activityId, enrollmentId])
  @@index([enrollmentId, updatedAt])
}

model Question {
  id          String           @id @default(uuid()) @db.Uuid
  activityId  String           @db.Uuid
  kind        String
  prompt      Json
  answerKey   Json
  explanation Json?
  sortOrder   Int
  activity    LearningActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, sortOrder])
}

model ActivityAttempt {
  id           String           @id @default(uuid()) @db.Uuid
  schoolId     String           @db.Uuid
  submissionId String           @db.Uuid
  activityId   String           @db.Uuid
  kind         String
  value        Json?
  autoResult   Json?
  createdAt    DateTime         @default(now())
  school       School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  submission   Submission       @relation(fields: [schoolId, submissionId], references: [schoolId, id], onDelete: Cascade)
  activity     LearningActivity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  audioAsset   AudioAsset?

  @@unique([schoolId, id])
  @@unique([submissionId, activityId])
  @@index([schoolId, submissionId])
}

model Submission {
  id             String            @id @default(uuid()) @db.Uuid
  schoolId       String            @db.Uuid
  assignmentId   String            @db.Uuid
  enrollmentId   String            @db.Uuid
  attemptNo      Int
  status         SubmissionStatus  @default(IN_PROGRESS)
  idempotencyKey String
  deviceId       String?           @db.Uuid
  revision       Int               @default(1)
  submittedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  school         School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignment     Assignment        @relation(fields: [schoolId, assignmentId], references: [schoolId, id], onDelete: Cascade)
  enrollment     Enrollment        @relation(fields: [schoolId, enrollmentId], references: [schoolId, id], onDelete: Restrict)
  device         Device?           @relation(fields: [schoolId, deviceId], references: [schoolId, id], onDelete: Restrict)
  attempts       ActivityAttempt[]
  feedback       Feedback[]
  speechJobs     SpeechJob[]

  @@unique([schoolId, id])
  @@unique([assignmentId, enrollmentId, attemptNo])
  @@unique([enrollmentId, idempotencyKey])
  @@index([assignmentId, status])
  @@index([schoolId, status])
  @@index([deletedAt])
}

model Feedback {
  id           String           @id @default(uuid()) @db.Uuid
  schoolId     String           @db.Uuid
  submissionId String           @db.Uuid
  authorUserId String           @db.Uuid
  decision     FeedbackDecision
  comment      String
  score        Float?
  revision     Int              @default(1)
  releasedAt   DateTime         @default(now())
  deletedAt    DateTime?
  school       School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  submission   Submission       @relation(fields: [schoolId, submissionId], references: [schoolId, id], onDelete: Cascade)
  author       User             @relation("FeedbackAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([submissionId, releasedAt])
  @@index([schoolId, releasedAt])
  @@index([deletedAt])
}

model Device {
  id              String           @id @default(uuid()) @db.Uuid
  schoolId        String           @db.Uuid
  campusId        String?          @db.Uuid
  membershipId    String?          @db.Uuid
  label           String?
  platform        String?
  appVersion      String?
  lastSeenAt      DateTime?
  createdAt       DateTime         @default(now())
  deletedAt       DateTime?
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus          Campus?          @relation(fields: [schoolId, campusId], references: [schoolId, id], onDelete: Restrict)
  owner           Membership?      @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Restrict)
  audioAssets     AudioAsset[]
  contentPackages ContentPackage[]
  syncJobs        SyncJob[]
  syncCursors     SyncCursor[]
  submissions     Submission[]

  @@unique([schoolId, id])
  @@index([schoolId, lastSeenAt])
  @@index([deletedAt])
}

model AudioAsset {
  id         String          @id @default(uuid()) @db.Uuid
  attemptId  String          @unique @db.Uuid
  resourceId String          @db.Uuid
  deviceId   String?         @db.Uuid
  durationMs Int
  quality    Json?
  createdAt  DateTime        @default(now())
  attempt    ActivityAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  resource   Resource        @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  device     Device?         @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  speechJobs SpeechJob[]
}

model SpeechJob {
  id                String          @id @default(uuid()) @db.Uuid
  submissionId      String          @db.Uuid
  audioAssetId      String          @db.Uuid
  status            SpeechJobStatus @default(CREATED)
  provider          String?
  providerModel     String?
  targetTextVersion String
  result            Json?
  confidence        Float?
  processingMs      Int?
  retryCount        Int             @default(0)
  errorCode         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  submission        Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  audioAsset        AudioAsset      @relation(fields: [audioAssetId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model SyncOperation {
  id           String              @id @default(uuid()) @db.Uuid
  schoolId     String              @db.Uuid
  deviceId     String              @db.Uuid
  syncJobId    String              @db.Uuid
  actorUserId  String              @db.Uuid
  operationId  String              @db.Uuid
  entityType   String
  entityId     String
  action       String
  baseRevision Int?
  payloadHash  String
  status       SyncOperationStatus
  result       Json?
  createdAt    DateTime            @default(now())
  processedAt  DateTime?
  syncJob      SyncJob             @relation(fields: [schoolId, deviceId, syncJobId], references: [schoolId, deviceId, id], onDelete: Cascade)

  @@unique([schoolId, actorUserId, operationId])
  @@index([schoolId, deviceId, status, createdAt])
  @@index([syncJobId])
}

model SyncJob {
  id                String          @id @default(uuid()) @db.Uuid
  schoolId          String          @db.Uuid
  deviceId          String          @db.Uuid
  clientOperationId String          @db.Uuid
  status            SyncJobStatus   @default(QUEUED)
  startedAt         DateTime?
  completedAt       DateTime?
  summary           Json?
  errorCode         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  school            School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  device            Device          @relation(fields: [schoolId, deviceId], references: [schoolId, id], onDelete: Cascade)
  operations        SyncOperation[]

  @@unique([schoolId, deviceId, id])
  @@unique([schoolId, deviceId, clientOperationId])
  @@index([schoolId, status])
  @@index([deviceId, status, createdAt])
}

model SyncCursor {
  id           String               @id @default(uuid()) @db.Uuid
  schoolId     String               @db.Uuid
  deviceId     String               @db.Uuid
  entityType   SyncCursorEntityType
  lastSyncedAt DateTime
  lastEntityId String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  device       Device               @relation(fields: [schoolId, deviceId], references: [schoolId, id], onDelete: Cascade)

  @@unique([deviceId, entityType])
  @@index([schoolId, deviceId])
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String?  @db.Uuid
  actorUserId   String?  @db.Uuid
  action        String
  resourceType  String
  resourceId    String?
  requestId     String
  beforeSummary Json?
  afterSummary  Json?
  createdAt     DateTime @default(now())
  school        School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  actor         User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
}

model Report {
  id                 String       @id @default(uuid()) @db.Uuid
  schoolId           String       @db.Uuid
  type               ReportType
  status             ReportStatus @default(PENDING)
  periodStart        DateTime
  periodEnd          DateTime
  filters            Json?
  dataCompleteness   Float        @default(0)
  providerDisclosure String       @default("")
  generatedAt        DateTime?
  generatedByUserId  String?      @db.Uuid
  enrollmentId       String?      @db.Uuid
  classId            String?      @db.Uuid
  data               Json?
  revision           Int          @default(1)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  school             School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@index([schoolId, type, status])
  @@index([schoolId, periodStart, periodEnd])
  @@index([enrollmentId])
  @@index([classId])
}

model OfflineContentPackage {
  id               String        @id @default(uuid()) @db.Uuid
  schoolId         String        @db.Uuid
  courseVersionId  String        @db.Uuid
  version          Int           @default(1)
  checksum         String
  manifest         Json
  byteSize         BigInt        @default(0)
  downloadRequired Boolean       @default(false)
  expiresAt        DateTime?
  revision         Int           @default(1)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  school           School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  courseVersion    CourseVersion @relation(fields: [schoolId, courseVersionId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@index([schoolId, courseVersionId, version])
  @@index([schoolId, expiresAt])
}

model SyncBatch {
  id                String          @id @default(uuid()) @db.Uuid
  schoolId          String          @db.Uuid
  deviceId          String          @db.Uuid
  clientBatchId     String          @unique
  status            SyncBatchStatus @default(ACCEPTED)
  operationCount    Int             @default(0)
  acceptedCount     Int             @default(0)
  duplicateCount    Int             @default(0)
  conflictCount     Int             @default(0)
  rejectedCount     Int             @default(0)
  permissionChanged Int             @default(0)
  summary           Json?
  errorCode         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  school            School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@index([schoolId, deviceId, status])
  @@index([schoolId, createdAt])
}

model VolunteerProfile {
  id              String    @id @default(uuid()) @db.Uuid
  schoolId        String    @db.Uuid
  userId          String    @db.Uuid
  status          String
  displayName     String
  phone           String
  email           String?
  experience      String?
  qualifications  String[]  @default([])
  appliedAt       DateTime  @default(now())
  qualifiedAt     DateTime?
  suspendedReason String?
  revision        Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@unique([schoolId, userId])
  @@index([schoolId, status, appliedAt])
}

model VolunteerServiceTask {
  id                    String   @id @default(uuid()) @db.Uuid
  schoolId              String   @db.Uuid
  title                 String
  serviceType           String
  classId               String?  @db.Uuid
  studentScope          String
  supervisorTeacherId   String   @db.Uuid
  requiredQualification String
  assignedVolunteerId   String?  @db.Uuid
  status                String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  school                School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@index([schoolId, assignedVolunteerId, status])
}

model VolunteerIncident {
  id                 String   @id @default(uuid()) @db.Uuid
  schoolId           String   @db.Uuid
  type               String
  severity           String
  description        String
  immediateAction    String?
  studentRef         String?
  assignedReviewerId String?  @db.Uuid
  status             String   @default("OPEN")
  resolution         String?
  reportedBy         String   @db.Uuid
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  school             School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@index([schoolId, severity, status, createdAt])
}

model TrainingProgram {
  id          String               @id @default(uuid()) @db.Uuid
  schoolId    String               @db.Uuid
  title       String
  description String?
  objectives  String[]             @default([])
  locale      String               @default("zh-CN")
  dialect     String?
  status      String               @default("DRAFT")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  modules     TrainingModule[]
  enrollments TrainingEnrollment[]
  exams       TrainingExam[]

  @@unique([schoolId, id])
  @@index([schoolId, status, createdAt])
}

model TrainingModule {
  id              String             @id @default(uuid()) @db.Uuid
  schoolId        String             @db.Uuid
  programId       String             @db.Uuid
  title           String
  description     String?
  sortOrder       Int
  required        Boolean            @default(true)
  durationMinutes Int?
  createdAt       DateTime           @default(now())
  program         TrainingProgram    @relation(fields: [schoolId, programId], references: [schoolId, id], onDelete: Cascade)
  progress        TrainingProgress[]

  @@unique([schoolId, id])
  @@unique([schoolId, programId, sortOrder])
  @@index([schoolId, programId])
}

model TrainingEnrollment {
  id              String             @id @default(uuid()) @db.Uuid
  schoolId        String             @db.Uuid
  programId       String             @db.Uuid
  volunteerUserId String             @db.Uuid
  status          String             @default("ENROLLED")
  enrolledAt      DateTime           @default(now())
  completedAt     DateTime?
  examReady       Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  school          School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  program         TrainingProgram    @relation(fields: [schoolId, programId], references: [schoolId, id], onDelete: Cascade)
  volunteer       User               @relation(fields: [volunteerUserId], references: [id], onDelete: Cascade)
  progress        TrainingProgress[]
  exams           TrainingExam[]

  @@unique([schoolId, id])
  @@unique([schoolId, programId, volunteerUserId])
  @@index([schoolId, volunteerUserId, status])
}

model TrainingProgress {
  id           String             @id @default(uuid()) @db.Uuid
  schoolId     String             @db.Uuid
  enrollmentId String             @db.Uuid
  moduleId     String             @db.Uuid
  completed    Boolean            @default(false)
  completedAt  DateTime?
  score        Float?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  enrollment   TrainingEnrollment @relation(fields: [schoolId, enrollmentId], references: [schoolId, id], onDelete: Cascade)
  module       TrainingModule     @relation(fields: [schoolId, moduleId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, enrollmentId, moduleId])
  @@index([schoolId, enrollmentId])
}

model TrainingExam {
  id           String                @id @default(uuid()) @db.Uuid
  schoolId     String                @db.Uuid
  programId    String                @db.Uuid
  enrollmentId String                @db.Uuid
  scheduledAt  DateTime
  status       String                @default("SCHEDULED")
  passingScore Float
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  school       School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  program      TrainingProgram       @relation(fields: [schoolId, programId], references: [schoolId, id], onDelete: Cascade)
  enrollment   TrainingEnrollment    @relation(fields: [schoolId, enrollmentId], references: [schoolId, id], onDelete: Cascade)
  attempts     TrainingExamAttempt[]

  @@unique([schoolId, id])
  @@index([schoolId, enrollmentId, status])
}

model TrainingExamAttempt {
  id          String       @id @default(uuid()) @db.Uuid
  schoolId    String       @db.Uuid
  examId      String       @db.Uuid
  score       Float
  passed      Boolean
  submittedAt DateTime
  createdAt   DateTime     @default(now())
  exam        TrainingExam @relation(fields: [schoolId, examId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@index([schoolId, examId, submittedAt])
}

model SupportPairing {
  id                  String           @id @default(uuid()) @db.Uuid
  schoolId            String           @db.Uuid
  studentUserId       String           @db.Uuid
  volunteerUserId     String           @db.Uuid
  supervisorTeacherId String           @db.Uuid
  consentStatus       String           @default("PENDING")
  goal                String
  status              String           @default("PENDING_CONSENT")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  school              School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sessions            SupportSession[]

  @@unique([schoolId, id])
  @@index([schoolId, volunteerUserId, status])
  @@index([schoolId, studentUserId, status])
}

model SupportSession {
  id                  String         @id @default(uuid()) @db.Uuid
  schoolId            String         @db.Uuid
  pairingId           String         @db.Uuid
  scheduledAt         DateTime
  summary             String?
  nextStep            String?
  riskLevel           String         @default("LOW")
  teacherReviewStatus String         @default("PENDING")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  pairing             SupportPairing @relation(fields: [schoolId, pairingId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@index([schoolId, pairingId, scheduledAt])
}
