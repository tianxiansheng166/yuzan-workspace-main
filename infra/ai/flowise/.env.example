# ── Flowise Configuration ──────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets to Git.

# Flowise UI login (set a strong password before first run)
FLOWISE_USERNAME=admin
FLOWISE_PASSWORD=

# CORS — comma-separated origins allowed to call Flowise API
CORS_ORIGINS=http://127.0.0.1:4175,http://localhost:4175

# IFRAME — leave empty to disable iframe embedding
IFRAME_ORIGINS=

# ── Flowise Flow ID ────────────────────────────────────
# After running bootstrap-flow.ps1, the flowId is written to
# runtime-local/flowise/flow-id.txt. Set it here or in your
# environment so the Worker can call the Prediction API.
# Alternatively, set FLOWISE_FLOW_ID as an environment variable
# when starting the Worker.
FLOWISE_FLOW_ID=

# ── Flowise API Key ────────────────────────────────────
# Generated in Flowise UI: Settings → API Keys
# Used by the Worker to authenticate Prediction API calls.
# Leave empty if Flowise auth is disabled (dev only).
FLOWISE_API_KEY=

# ── AI Provider (used by internal proxy, NOT by Flowise directly) ──
# Real values go in runtime-local/secrets/ai-provider.env
# Flowise itself is configured to call the internal proxy:
#   host.docker.internal:4000/api/v1/internal/ai/openai/v1/chat/completions
#
# To set up the AI provider:
#   1. Copy runtime-local/secrets/ai-provider.env.example to ai-provider.env
#   2. Fill in AI_BASE_URL, AI_API_KEY, AI_MODEL
#   3. Restart the API server
#
# In Flowise UI, create a Chat Model node pointing to:
#   Base URL: http://host.docker.internal:4000/api/v1/internal/ai/openai/v1
#   API Key: (leave empty — auth is handled by X-Internal-Key header)
