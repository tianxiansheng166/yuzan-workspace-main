{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuzan.local/schemas/evidence-manifest.schema.json",
  "title": "Yuzan independent evidence manifest",
  "type": "object",
  "required": [
    "schema_version", "task_id", "journey_id", "run_id", "attempt", "verifier_id",
    "implementer_id", "candidate_commit", "runtime_commit", "runtime_clean", "started_at",
    "finished_at", "levels", "dynamic_ids", "browser", "cross_checks", "forbidden_usage",
    "artifacts", "verdict"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "minLength": 3},
    "journey_id": {"type": "string", "minLength": 3},
    "run_id": {"type": "string", "pattern": "^E2E-[0-9]{8}-[A-Za-z0-9-]{6,}$"},
    "attempt": {"type": "integer", "minimum": 1},
    "verifier_id": {"type": "string", "minLength": 1},
    "implementer_id": {"type": "string", "minLength": 1},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runtime_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runtime_clean": {"const": true},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "levels": {
      "type": "object",
      "required": ["L3_BROWSER", "L4_PERSISTENCE", "L5_FRESH_CONTEXT_NEGATIVE"],
      "properties": {
        "L3_BROWSER": {"const": "PASS"},
        "L4_PERSISTENCE": {"const": "PASS"},
        "L5_FRESH_CONTEXT_NEGATIVE": {"const": "PASS"}
      },
      "additionalProperties": true
    },
    "dynamic_ids": {
      "type": "object",
      "required": ["assignment_id", "attempt_or_submission_id", "recording_id"],
      "additionalProperties": {"type": "string", "minLength": 2}
    },
    "browser": {
      "type": "object",
      "required": ["teacher_contexts", "student_contexts", "primary_writes_from_ui", "route_interception", "console_errors", "page_errors", "unexpected_request_failures", "viewports"],
      "properties": {
        "teacher_contexts": {"type": "integer", "minimum": 2},
        "student_contexts": {"type": "integer", "minimum": 1},
        "primary_writes_from_ui": {"const": true},
        "route_interception": {"const": false},
        "console_errors": {"type": "integer", "maximum": 0},
        "page_errors": {"type": "integer", "maximum": 0},
        "unexpected_request_failures": {"type": "integer", "maximum": 0},
        "viewports": {"type": "array", "contains": {"const": "390x844"}}
      },
      "additionalProperties": true
    },
    "cross_checks": {
      "type": "object",
      "required": ["api", "database", "object_storage", "tenant_negative"],
      "additionalProperties": {"enum": ["PASS"]}
    },
    "forbidden_usage": {
      "type": "array",
      "maxItems": 0
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "verdict": {"enum": ["VERIFIED"]}
  },
  "allOf": [
    {"not": {"properties": {"verifier_id": {"const": ""}}}},
    {"not": {"properties": {"implementer_id": {"const": ""}}}}
  ],
  "additionalProperties": true
}
