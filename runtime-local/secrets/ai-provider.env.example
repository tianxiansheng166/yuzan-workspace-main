# ── AI Provider Configuration ──────────────────────────────
# Copy this file to ai-provider.env and fill in real values.
# NEVER commit ai-provider.env with real secrets to Git.
#
# This file configures the internal AI proxy endpoint that Flowise
# calls for LLM inference. The proxy forwards requests to the real
# AI provider (OpenAI, Azure OpenAI, etc.) with proper auth.
#
# The internal proxy endpoint is:
#   http://127.0.0.1:4000/api/v1/internal/ai/openai/v1/chat/completions
# In Docker, Flowise accesses it as:
#   http://host.docker.internal:4000/api/v1/internal/ai/openai/v1/chat/completions

# ── Provider Selection ──
# Currently only "openai-compatible" is supported.
AI_PROVIDER_TYPE=openai-compatible

# ── OpenAI-Compatible Configuration ──
# Base URL of the AI provider API (without /chat/completions path)
AI_BASE_URL=https://api.openai.com/v1

# API key for the AI provider
AI_API_KEY=sk-...

# Model to use for lesson plan generation
AI_MODEL=gpt-4o

# ── Optional: Azure OpenAI ──
# If using Azure OpenAI, set these instead:
# AI_BASE_URL=https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
# AI_API_KEY=your-azure-key
# AI_API_VERSION=2024-12-01-preview

# ── Stub Mode ──
# Set AI_PROVIDER_STUB=true to use the provider stub instead of a real provider.
# This is for local testing without API keys.
# AI_PROVIDER_STUB=true
# AI_STUB_SCENARIO=valid-output
