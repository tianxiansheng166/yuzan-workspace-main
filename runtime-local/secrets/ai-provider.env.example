# ── AI Provider Configuration ──────────────────────────
# Copy this file to ai-provider.env and fill in real values.
# This file is gitignored — NEVER commit real secrets.
#
# These values are read by the internal provider proxy in apps/api.
# Flowise never sees these values — it only knows the internal proxy URL.

AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=120000
AI_MAX_OUTPUT_TOKENS=
AI_TEMPERATURE=0.3
