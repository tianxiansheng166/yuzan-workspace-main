{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "types": ["vitest/globals", "@vue/test-utils"]
  },
  "include": ["tests/**/*.ts", "app/**/*.ts", "app/**/*.vue"]
}
