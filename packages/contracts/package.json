{
  "name": "@yuzan/contracts",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "redocly lint openapi/openapi.yaml",
    "generate": "node scripts/generate-types.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "redocly lint openapi/openapi.yaml",
    "test": "redocly lint openapi/openapi.yaml && node --test scripts/generate-types.test.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "^1.34.2",
    "openapi-typescript": "^7.8.0",
    "typescript": "^5.8.3"
  }
}
